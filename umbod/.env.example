# Umbod configuration.
# Local development needs none of this: `docker compose up` runs the local/dev profile.
# The values below are the production checklist. Run `umbod config validate` to check them.

# --- Intent ---
UMBOD_PROFILE=production
UMBOD_AUTH=auth0

# --- Topology (set once; URLs, CORS and redirects are derived from these) ---
UMBOD_PUBLIC_SITE_ORIGIN=https://umbod-admin.computerlove.tech
UMBOD_PUBLIC_API_ORIGIN=https://umbod-admin.computerlove.tech
UMBOD_PUBLIC_MCP_ORIGIN=https://umbod.computerlove.tech
UMBOD_INTERNAL_API_ORIGIN=http://api:8000

# --- Persistence ---
UMBOD_DATA_DIR=/app/data
UMBOD_CONNECTOR_STORE=sqlite
UMBOD_MCP_TOOL_EXPOSURE=flat
UMBOD_MCP_MESSAGING_TRANSPORT=sql
UMBOD_FEATURE_MCP_ADMINISTRATOR_ENABLED=true
UMBOD_MCP_DOWNSTREAM_DISCOVERY_ENABLED=true
UMBOD_MCP_DOWNSTREAM_DISCOVERY_TIMEOUT_SECONDS=10
UMBOD_MCP_DOWNSTREAM_REFRESH_INTERVAL_SECONDS=60
UMBOD_MCP_DOWNSTREAM_DISCOVERY_CONCURRENCY=4
UMBOD_MCP_DOWNSTREAM_DISCOVERY_JITTER_RATIO=0.1
UMBOD_MCP_DOWNSTREAM_DISCOVERY_MAXIMUM_BACKOFF_SECONDS=900

# --- Auth recipe (auth0) ---
UMBOD_OIDC_DOMAIN=example.eu.auth0.com
UMBOD_OIDC_CLIENT_ID=
UMBOD_OIDC_CLIENT_SECRET=
UMBOD_OIDC_AUDIENCE=
UMBOD_OIDC_REQUIRED_SCOPES=openid,email,profile,groups
UMBOD_ADMIN_GROUP=umbod:admin
UMBOD_ADMIN_MEMBERSHIP_CLAIM=https://umbod.computerlove.tech/claims/groups
UMBOD_MCP_PERMISSION_CLAIM=https://umbod.computerlove.tech/claims/groups

# --- Secrets (must be stable across redeployments) ---
# Required derivation root for backend security secrets. Keep it stable across redeployments.
UMBOD_ROOT_SECRET=
# --- Admin sign-in sidecar (oauth2-proxy) ---
UMBOD_OAUTH2_PROXY_COOKIE_SECRET=
UMBOD_OAUTH2_PROXY_SCOPE=openid email profile permissions offline_access
